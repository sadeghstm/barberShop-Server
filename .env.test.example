# کپی کنید به .env.test (commit نشود). تست‌های API روی این دیتابیس‌ها «همه‌چیز را پاک می‌کنند»،
# پس باید دیتابیس جدا باشند:
#   - نام دیتابیس مونگو حتماً به test ختم شود
#   - ردیس حتماً شماره دیتابیس غیر از صفر داشته باشد (مثل /1)
MONGO_URI=mongodb://127.0.0.1:27017/barbershop_test
REDIS_URL=redis://127.0.0.1:6379/1
LOG_LEVEL=silent

# کپی کنید به .env (فایل .env را commit نکنید)
NODE_ENV=development
PORT=3000

# در production هر دو الزامی‌اند؛ در development مقدار پیش‌فرض دارند
MONGO_URI=mongodb://127.0.0.1:27017/barbershop
REDIS_URL=redis://127.0.0.1:6379

# debug | info | warn | error | silent
LOG_LEVEL=debug

# تعداد proxyهای جلوی سرور (برای ip درست در auditLogs). بدون proxy: 0
TRUST_PROXY=0

BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# آدرس فرانت‌اند (برای CORS با کوکی)
CORS_ORIGIN=http://localhost:5173

# آدرس عمومی برنامه برای ساخت لینک معرفی (پیش‌فرض: همان CORS_ORIGIN)
APP_BASE_URL=http://localhost:5173

# مدت اعتبار نشست (روز)
SESSION_TTL_DAYS=7

# کد ثابت OTP فقط در development (در production نادیده گرفته می‌شود)
DEV_OTP_CODE=12345

# پیامک: mock (توسعه) یا kavenegar (production). در mock هیچ پیامکی ارسال نمی‌شود.
SMS_PROVIDER=mock
# فقط برای kavenegar لازم است
SMS_API_KEY=
SMS_SENDER=
